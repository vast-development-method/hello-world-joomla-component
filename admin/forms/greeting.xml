<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JCB\Component\Helloworld\Administrator\Rule"
	addfieldprefix="JCB\Component\Helloworld\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 266] Default Fields. -->
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 268] Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 287] Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_HELLOWORLD_GREETING_CREATED_DATE_LABEL"
			description="COM_HELLOWORLD_GREETING_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 310] User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_HELLOWORLD_GREETING_CREATED_BY_LABEL"
			description="COM_HELLOWORLD_GREETING_CREATED_BY_DESC"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 330] Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 357] Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_HELLOWORLD_GREETING_MODIFIED_DATE_LABEL" description="COM_HELLOWORLD_GREETING_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 372] User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_HELLOWORLD_GREETING_MODIFIED_BY_LABEL"
			description="COM_HELLOWORLD_GREETING_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 391] Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 410] Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_HELLOWORLD_GREETING_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 433] Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_HELLOWORLD_GREETING_VERSION_LABEL"
			description="COM_HELLOWORLD_GREETING_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 457] Metakey Field. Type: Textarea (joomla) -->
		<field
			name="metakey"
			type="textarea"
			label="JFIELD_META_KEYWORDS_LABEL"
			description="JFIELD_META_KEYWORDS_DESC"
			rows="3"
			cols="30"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 475] Metadesc Field. Type: Textarea (joomla) -->
		<field
			name="metadesc"
			type="textarea"
			label="JFIELD_META_DESCRIPTION_LABEL"
			description="JFIELD_META_DESCRIPTION_DESC"
			rows="3"
			cols="30"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 499] Was added due to Permissions JS needing a Title field -->
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 501] Let us know at gh-629 should this change -->
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 503] https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="helloworld greeting"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 529] Dynamic Fields. -->
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldString 289] Greeting Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="greeting"
			label="COM_HELLOWORLD_GREETING_GREETING_LABEL"
			size="10"
			maxlength="50"
			default="Some text"
			description="COM_HELLOWORLD_GREETING_GREETING_DESCRIPTION"
			class="text_area"
			filter="STRING"
			message="COM_HELLOWORLD_GREETING_GREETING_MESSAGE"
			hint="COM_HELLOWORLD_GREETING_GREETING_HINT"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldString 289] Alias Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="alias"
			label="COM_HELLOWORLD_GREETING_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			filter="STRING"
			hint="COM_HELLOWORLD_GREETING_ALIAS_HINT"
		/>
	</fieldset>

	<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 542] Metadata Fields. -->
	<fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
		<fieldset name="vdmmetadata"
			label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
			<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 553] Robots Field. Type: List (joomla) -->
			<field name="robots"
				type="list"
				label="JFIELD_METADATA_ROBOTS_LABEL"
				description="JFIELD_METADATA_ROBOTS_DESC" >
				<option value="">JGLOBAL_USE_GLOBAL</option>
				<option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
				<option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
				<option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
				<option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
			</field>
			<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 579] Author Field. Type: Text (joomla) -->
			<field name="author"
				type="text"
				label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
				size="20"
			/>
			<!-- [VDM\Joomla\Componentbuilder\Compiler\Creator\FieldsetString 594] Rights Field. Type: Textarea (joomla) -->
			<field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
				description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
				cols="30" rows="2"
			/>
		</fieldset>
	</fields>

	<!-- [VDM\Joomla\Componentbuilder\Compiler\Helper\Interpretation 15737] Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Helper\Interpretation 15742] Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- [VDM\Joomla\Componentbuilder\Compiler\Helper\Interpretation 15750] Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this greeting"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_helloworld"
			section="greeting"
		/>
	</fieldset>
</form>